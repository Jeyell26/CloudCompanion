# ============================================================
# LogPulse — Mock Data for LocalStack dev sessions
# Loaded by API calls when a LocalStack session is detected.
# All values are JSON strings parsed at runtime.
# ============================================================

# --- Auth ---
VITE_MOCK_AUTH_TOKEN_PREFIX=mock_logpulse_

# --- Log Groups ---
VITE_MOCK_LOG_GROUPS=[{"name":"/aws/lambda/processImage","storedBytes":4194304,"retentionDays":30},{"name":"/aws/lambda/cleanupLogs","storedBytes":1048576,"retentionDays":14},{"name":"/aws/lambda/iotTelemetryIngest","storedBytes":8388608,"retentionDays":90},{"name":"/aws/ecs/production-api-server","storedBytes":52428800,"retentionDays":60},{"name":"/aws/apigateway/dashboard-gateway","storedBytes":2097152,"retentionDays":7},{"name":"/aws/rds/prod-db-cluster","storedBytes":10485760,"retentionDays":30},{"name":"/aws/vpc/flow-logs","storedBytes":209715200,"retentionDays":7}]

# --- Live Tail — message templates (JSON array of strings) ---
VITE_MOCK_LIVE_TAIL_MESSAGES=["[INFO] Health check OK — uptime {n}s","[INFO] Request processed in {n}ms — user {uuid}","[DEBUG] GC cycle complete — freed {n}MB","[WARN] Slow query detected: {n}ms on table users","[INFO] Cache hit ratio: {n}%","[ERROR] Connection timeout to Redis — retrying ({n}/3)","[INFO] Background job completed — processed {n} records","[DEBUG] Auth token validated for session {uuid}","[INFO] POST /api/events — 200 OK — {n}ms","[WARN] Rate limit approaching for IP {ip}"]

# --- Range Query — log templates (JSON array of strings) ---
VITE_MOCK_RANGE_QUERY_TEMPLATES=["[INFO] Request handled — route=/api/health method=GET status=200 latency={n}ms","[ERROR] Unhandled exception in worker — TypeError: Cannot read property of undefined","[INFO] Database query executed in {n}ms rows=42","[WARN] Memory usage high: {n}% of heap allocated","[DEBUG] Cache miss for key user:{uuid}","[INFO] Scheduled job triggered: cleanup-old-sessions","[INFO] User {uuid} authenticated successfully","[WARN] Deprecated API endpoint called: /api/v1/legacy","[ERROR] Failed to connect to external API — timeout after {n}ms","[INFO] Image uploaded: size={n}KB bucket=user-uploads-dev"]
