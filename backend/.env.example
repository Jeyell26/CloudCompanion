# .env.example — copy to .env and fill in values before running the backend.
# Never commit .env to source control.

# ---- Server ----------------------------------------------------------------
PORT=5000

# ---- JWT -------------------------------------------------------------------
# Secret used to sign/verify tokens issued by POST /api/auth/login.
# Use a long random string in production (e.g. openssl rand -hex 64).
JWT_SECRET=change_me_before_production

# Token expiry in hours.
JWT_EXPIRES_HOURS=8

# ---- AWS / LocalStack ------------------------------------------------------
# When targeting LocalStack set AWS_ENDPOINT to http://localhost:4566
# and use dummy key/secret. Leave AWS_ENDPOINT unset for real AWS.
AWS_ENDPOINT=
AWS_REGION=us-east-1

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. http://localhost:5173).
# Defaults to * when unset (fine for local dev, tighten in production).
CORS_ORIGIN=http://localhost:5173
